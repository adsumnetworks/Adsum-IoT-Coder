# Internal planning repo — cloned here for agent context only; has its own remote.
# Never tracked by the code repo (strategy/docs stay out of code history).
Adsum-Planning/

# Internal knowledge backend — cloned here to pull/push the proprietary K-bit .md
# files via its own npm scripts; has its own remote. Never tracked by the code repo.
Adsum-Backend/

# Adsum Knowledge Studio — our second extension (k-bit authoring/visualisation).
# Cloned here for convenience; has its own remote. Never tracked by the code repo.
adsum-studio/

# Public demo program — firmware, prompts and evidence for the docs-site demo pages.
# Cloned here for agent context; has its own remote. Never tracked by the code repo.
adsum-demos/

# Docs site source (Mintlify, docs.adsumnetworks.com) — its own remote.
# Cloned here so demo pages can be written next to the firmware they describe.
adsumcoder-docs/
.clangd

# Local MCP server config (Nordic MCP etc.) — per-developer, keep out of repo history
.mcp.json
.vscode/mcp.json

# Tooling/agent artifact (holds local prod context) — never commit
.embedder/

# Python bytecode from running the wrapper scripts / their tests locally
__pycache__/
*.pyc

# Claude Code local settings (machine-specific permissions; the shared variant is .claude/settings.json)
.claude/settings.local.json

# local one-off probe scripts, see .dev-probes/README.md
.dev-probes/

# The extension's workspace memory for this repo: local notes and paths, never committed or shipped.
.adsum/
