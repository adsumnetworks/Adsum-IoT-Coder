#!/usr/bin/env bash
# Modem Trace Wrapper
# Hides the internal Python script path from user-facing surfaces.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Pick an interpreter that actually RUNS, not merely one that exists.
# `command -v python3` is not enough: on Windows/Git Bash it matches the Microsoft Store stub,
# which prints an advert and exits non-zero. Some minimal Linux images have the same shape with a
# dangling symlink. Executing a trivial program is the only honest test.
PY=""
for candidate in python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys' >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "ERROR: no working Python found (tried python3, python)." >&2
  echo "  Debian/Ubuntu: sudo apt install python3 python3-pip" >&2
  echo "  macOS:         brew install python3" >&2
  exit 1
fi

# PYTHONNOUSERSITE=1 isolates from user-site .pth conflicts (see CLAUDE.md, bug B1).
exec env PYTHONNOUSERSITE=1 "$PY" "${SCRIPT_DIR}/modem_trace.py" "$@"
