{
	"$ref": "#/definitions/KBitMeta",
	"definitions": {
		"KBitMeta": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
				},
				"title": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"type": "string",
					"enum": [
						"workflow",
						"action",
						"knowledge",
						"tool"
					]
				},
				"version": {
					"type": "string",
					"pattern": "^\\d+\\.\\d+\\.\\d+$"
				},
				"owner": {
					"type": "string",
					"enum": [
						"adsum-core",
						"adsum-extended",
						"community",
						"partner"
					]
				},
				"author": {
					"type": "string",
					"minLength": 1
				},
				"license": {
					"type": "string",
					"minLength": 1
				},
				"tier": {
					"type": "string",
					"enum": [
						"community",
						"certified"
					]
				},
				"delivery": {
					"type": "string",
					"enum": [
						"bundled",
						"downloaded"
					]
				},
				"domain": {
					"type": "string",
					"minLength": 1
				},
				"platform": {
					"type": "string",
					"enum": [
						"nrf",
						"esp",
						"universal"
					]
				},
				"triggers": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"soc": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"sdk": {
					"type": "string",
					"minLength": 1
				},
				"sdk_version": {
					"type": "string",
					"minLength": 1
				},
				"requires": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
					}
				},
				"loaded_by": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
					}
				},
				"last_verified": {
					"type": "object",
					"properties": {
						"date": {
							"type": "string",
							"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
						},
						"env": {
							"type": "string",
							"minLength": 1
						}
					},
					"required": [
						"date",
						"env"
					],
					"additionalProperties": false
				},
				"safety": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"shell",
							"flash",
							"erase",
							"network",
							"fs-write",
							"process-kill",
							"long-running"
						]
					}
				},
				"supersedes": {
					"type": "string",
					"pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
				},
				"min_ext": {
					"type": "string",
					"pattern": "^\\d+\\.\\d+\\.\\d+$"
				},
				"min_ncs": {
					"type": "string",
					"pattern": "^\\d+\\.\\d+\\.\\d+$"
				},
				"content_hash": {
					"type": "string"
				},
				"access": {
					"type": "string",
					"enum": [
						"free",
						"pro"
					]
				},
				"group": {
					"type": "string",
					"enum": [
						"cellular-advanced",
						"edge-ai-advanced",
						"lew840x-demo-hex",
						"lew840x-prod-hex",
						"lew840x-ble-src",
						"lew840x-esp-src",
						"lew840x-9160-src",
						"blg20-demo-hex",
						"blg20-prod-hex",
						"blg20-ble-src",
						"blg20-esp-src",
						"blg20-9151-src",
						"blg20-early-access",
						"blg20-adv-ble",
						"blg20-adv-full",
						"all"
					]
				},
				"runtime": {
					"type": "string",
					"enum": [
						"python3",
						"node",
						"wasm",
						"native",
						"host"
					]
				},
				"entry": {
					"type": "string",
					"minLength": 1
				},
				"host_tool": {
					"type": "string",
					"minLength": 1
				},
				"usage": {
					"type": "string",
					"minLength": 1
				},
				"artifacts": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"path": {
								"type": "string",
								"pattern": "^[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
							},
							"sha256": {
								"type": "string",
								"pattern": "^[0-9a-f]{64}$"
							},
							"platform": {
								"type": "string",
								"enum": [
									"darwin-arm64",
									"darwin-x64",
									"linux-x64",
									"linux-arm64",
									"win32-x64"
								]
							},
							"group": {
								"type": "string",
								"enum": [
									"cellular-advanced",
									"edge-ai-advanced",
									"lew840x-demo-hex",
									"lew840x-prod-hex",
									"lew840x-ble-src",
									"lew840x-esp-src",
									"lew840x-9160-src",
									"blg20-demo-hex",
									"blg20-prod-hex",
									"blg20-ble-src",
									"blg20-esp-src",
									"blg20-9151-src",
									"blg20-early-access",
									"blg20-adv-ble",
									"blg20-adv-full",
									"all"
								]
							},
							"open": {
								"type": "boolean",
								"const": true
							}
						},
						"required": [
							"path",
							"sha256"
						],
						"additionalProperties": false
					}
				},
				"requires_tools": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"readonly": {
					"type": "boolean"
				},
				"timeout_s": {
					"type": "integer",
					"exclusiveMinimum": 0,
					"maximum": 3600
				},
				"co_authors": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"handle": {
								"type": "string",
								"minLength": 1
							},
							"name": {
								"type": "string",
								"minLength": 1
							},
							"affiliation": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"handle"
						],
						"additionalProperties": false
					}
				},
				"endorsers": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"handle": {
								"type": "string",
								"minLength": 1
							},
							"name": {
								"type": "string",
								"minLength": 1
							},
							"affiliation": {
								"type": "string",
								"minLength": 1
							},
							"version": {
								"type": "string",
								"pattern": "^\\d+\\.\\d+\\.\\d+$"
							},
							"date": {
								"type": "string",
								"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
							},
							"verified": {
								"type": "boolean",
								"default": false
							},
							"statement": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"handle",
							"version",
							"date"
						],
						"additionalProperties": false
					}
				},
				"supporters": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"handle": {
								"type": "string",
								"minLength": 1
							},
							"name": {
								"type": "string",
								"minLength": 1
							},
							"affiliation": {
								"type": "string",
								"minLength": 1
							},
							"kind": {
								"type": "string",
								"enum": [
									"sponsor",
									"backer"
								],
								"default": "sponsor"
							}
						},
						"required": [
							"handle"
						],
						"additionalProperties": false
					}
				},
				"status": {
					"type": "string",
					"enum": [
						"draft",
						"published",
						"deprecated",
						"revoked"
					]
				},
				"created": {
					"type": "string",
					"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
				},
				"updated": {
					"type": "string",
					"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
				}
			},
			"required": [
				"id",
				"title",
				"type",
				"version",
				"owner",
				"author",
				"license",
				"tier",
				"delivery",
				"domain"
			],
			"additionalProperties": false
		}
	},
	"$schema": "http://json-schema.org/draft-07/schema#"
}
